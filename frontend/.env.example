NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Cartographie (optionnel). Par défaut : tuiles OpenStreetMap standard (usage léger : démonstration).
# Pour une forte audience, utiliser un fournisseur commercial ou un serveur de tuiles auto-hébergé (voir CARTOGRAPHIE.md).
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Adresse de contact affichée en pied de page (recommandé par la politique OSM)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@exemple.sn

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pharmaloc
# Secrets: 32+ caracteres aléatoires (ex: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
